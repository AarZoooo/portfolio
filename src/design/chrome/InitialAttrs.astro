---
// Pre-paint script that sets palette and width from localStorage
// so returning visitors don't flash wrong modes. Mirror any change in
// @hooks/useTheme's STORAGE_KEYS / ATTRS.
---

<script is:inline>
    ;(function () {
        // Keep in sync with @utils/palettes PALETTES (names + modes).
        var PALETTES = [
            { name: 'monochrome-light', mode: 'light' },
            { name: 'monochrome-dark', mode: 'dark' },
            { name: 'meddle', mode: 'dark' },
        ]
        var d = document.documentElement
        try {
            var p = parseInt(localStorage.getItem('palette'), 10)
            if (isNaN(p)) {
                p = matchMedia('(prefers-color-scheme: dark)').matches ? 1 : 0
            } else {
                p = Math.max(0, Math.min(p, PALETTES.length - 1))
            }
            d.setAttribute('data-palette', PALETTES[p].name)
            d.setAttribute('data-mode', PALETTES[p].mode)

            var w = localStorage.getItem('width')
            if (w === 'wide' || w === 'narrow') d.setAttribute('data-width', w)
        } catch (_) {
            try {
                var dark = matchMedia('(prefers-color-scheme: dark)').matches
                d.setAttribute('data-palette', dark ? 'monochrome-dark' : 'monochrome-light')
                d.setAttribute('data-mode', dark ? 'dark' : 'light')
            } catch (__) {
                /* matchMedia unavailable — CSS default applies */
            }
        }
    })()
</script>
